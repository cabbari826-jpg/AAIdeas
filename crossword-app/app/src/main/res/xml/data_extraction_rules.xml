<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the same for cloud backup and for moving to a new phone. Premium comes from Google Play, not from a backup. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="file" path="packs/" />
        <exclude domain="sharedpref" path="premium.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="file" path="packs/" />
        <exclude domain="sharedpref" path="premium.xml" />
    </device-transfer>
</data-extraction-rules>
